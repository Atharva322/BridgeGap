# Copy to .env (gitignored) and fill in. Read by `npm run relay -- run`. See docs/SLACK-SETUP.md.

# Bot User OAuth Token (OAuth & Permissions page), starts with xoxb-
SLACK_BOT_TOKEN=
# App-Level Token with the connections:write scope (Basic Information page), starts with xapp-
SLACK_APP_TOKEN=
# Comma-separated Slack member IDs allowed to approve (profile -> ... -> Copy member ID), e.g. U012AB3CD
BRIDGEGAP_SLACK_APPROVERS=

# Optional relay settings
# BRIDGEGAP_RELAY_HOST=127.0.0.1
# BRIDGEGAP_RELAY_PORT=47700
# BRIDGEGAP_RELAY_PUBLIC_URL=https://relay.example.com   # what paired daemons connect to; use TLS off-machine
